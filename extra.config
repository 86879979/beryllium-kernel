# USB serial adapters (FTDI / PL2303 / CH341)
CONFIG_USB_SERIAL=y
CONFIG_USB_SERIAL_GENERIC=y
CONFIG_USB_SERIAL_FTDI_SIO=y
CONFIG_USB_SERIAL_PL2303=y
CONFIG_USB_SERIAL_CH341=y

# Bluetooth: RFCOMM / BNEP / HIDP
CONFIG_BT_RFCOMM=y
CONFIG_BT_RFCOMM_TTY=y
CONFIG_BT_BNEP=y
CONFIG_BT_BNEP_MC_FILTER=y
CONFIG_BT_BNEP_PROTO_FILTER=y
CONFIG_BT_HIDP=y

# Raw HID access
CONFIG_HIDRAW=y

# NTFS (kernel driver, read-only; for writing use ntfs-3g through FUSE)
CONFIG_NTFS_FS=y

# NFS client
CONFIG_NFS_FS=y
CONFIG_NFS_V3=y
CONFIG_NFS_V4=y

# CIFS / SMB client
CONFIG_CIFS=y
CONFIG_CIFS_XATTR=y
